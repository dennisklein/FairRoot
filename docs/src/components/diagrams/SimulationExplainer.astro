const at = (a: P, b: P, x: number): P => [x, a[1] + ((b[1] - a[1]) * (x - a[0])) / (b[0] - a[0])];
const mix = (a: P, b: P, f: number): P => [a[0] + (b[0] - a[0]) * f, a[1] + (b[1] - a[1]) * f];
const f1 = (n: number) => Math.round(n * 10) / 10;
const line = (a: P, b: P) => `M${f1(a[0])} ${f1(a[1])} L${f1(b[0])} ${f1(b[1])}`;
// Track segments: id, primary or secondary, start, end, number of step dots, draw time and delay (ms).
type Seg = { id: string; sec: boolean; a: P; b: P; n: number; dur: number; del: number };
function geometry(L: Lay) {
  const x0 = L.slab.x;
  const x1 = L.slab.x + L.slab.w;
  const E1 = at(L.V, L.z1, x0);
  const I1 = at(L.V, L.z1, (x0 + x1) / 2);
  const X1 = at(L.V, L.z1, x1);
  const E0 = at(L.V, L.z0, x0);
  const X0 = at(L.V, L.z0, x1);
  const segs: Seg[] = [
    { id: 'p1a', sec: false, a: L.V, b: E1, n: 5, dur: 1200, del: 0 },
    { id: 'p1b', sec: false, a: E1, b: I1, n: 1, dur: 300, del: 0 },
    { id: 'p1c', sec: false, a: I1, b: X1, n: 1, dur: 300, del: 0 },
    { id: 'p1d', sec: false, a: X1, b: L.z1, n: 3, dur: 350, del: 0 },
    { id: 'p2', sec: true, a: I1, b: L.s2, n: 2, dur: 400, del: 0 },
    { id: 'p0a', sec: false, a: L.V, b: E0, n: 5, dur: 350, del: 0 },
    { id: 'p0b', sec: false, a: E0, b: X0, n: 1, dur: 150, del: 350 },
    { id: 'p0c', sec: false, a: X0, b: L.z0, n: 3, dur: 300, del: 0 },
  ];
  // The part of each track in the sensitive volume, in the order of the points: #1, #2, #0.
  const inside: [P, P][] = [
    [E1, X1],
    [I1, L.s2],
    [E0, X0],
  ];
  return { segs, inside, I1 };
}
// The step dots of a segment: the last dot is at the end of the segment.
const dots = (s: Seg) =>
  Array.from({ length: s.n }, (_, k) => {
    const f = (k + 1) / s.n;
    const [x, y] = mix(s.a, s.b, f);
    return { x: f1(x), y: f1(y), d: Math.round(s.del + s.dur * f) };
  });
const lays = [wide, narrow].map((L) => ({ L, ...geometry(L) }));

const gens = ['FairBoxGenerator', 'FairParticleGenerator'];
// The tracks of the event: #0 and #1 are primaries (one from each generator), #2 is a secondary of #1.
// a: where the chip starts, b: its place on the stack, c: the engine.
const chipsOf = (L: Lay) => [
  { cls: 'c0', label: '#0', sec: false, a: [L.rows[0].x + (L.rows[0].w - L.cw) / 2, L.rows[0].y], b: L.slots[0] },
  { cls: 'c1', label: '#1', sec: false, a: [L.rows[1].x + (L.rows[1].w - L.cw) / 2, L.rows[1].y], b: L.slots[1] },
  { cls: 'c2', label: '#2', sec: true, a: L.spawn2, b: L.slots[1] },
];
const pos = (k: string, p: number[]) => `--${k}x:${f1(p[0])}px;--${k}y:${f1(p[1])}px`;
const pointIds = ['#1', '#2', '#0'];
const cellNames = ['MCEventHeader.', 'MCTrack', 'TutorialDetPoint'];
const cellCounts = ['', '3', '3'];
const fe = ['FillTrackArray()', 'UpdateTrackIndex()', 'FinishEvent()', 'Fill()', 'EndOfEvent()', 'Reset()'];
const label =
  'One simulated event. FairPrimaryGenerator puts two primary tracks onto FairStack. TGeant3 takes the tracks from the stack, last in, first out, and moves each one in steps through the cave. In the sensitive volume tutdet1, FairTutorialDet1 adds MC points, and a secondary track goes onto the stack. When the stack is empty, FairStack fills the MCTrack array, and FairRootManager fills one entry of the tree cbmsim.';
---

<Explainer title="One event of a simulation run" meta="TGeant3 · FairStack · FairTutorialDet1" steps={steps}>
  <div class="se-wrap">
    <svg class="se" data-stage data-beats={JSON.stringify(beats)} role="img" aria-label={label}>
      {
        lays.map(({ L, segs, inside, I1 }) => (
          <svg class={`lay lay-${L.key}`} viewBox={`0 0 ${L.W} ${L.H}`} width="100%" height="100%">
            {/* FairPrimaryGenerator and its generators */}
            <rect class="bx bx-gen" x={L.gen.x} y={L.gen.y} width={L.gen.w} height={L.gen.h} rx="3" />
            <text class="ttl" x={L.genT[0]} y={L.genT[1]}>
              FairPrimaryGenerator
            </text>
            {L.rows.map((r, i) => (
              <g class={`row row${i}`}>
                <rect x={r.x} y={r.y} width={r.w} height={r.h} rx="2" />
                <text x={r.x + 7} y={r.y + r.h / 2 + 4}>
                  {gens[i]}
                </text>
              </g>
            ))}
            <g class="arr-add">
              <path d={`M${L.add.x} ${L.add.y1} V${L.add.y2 - 6}`} class="arr" />
              <path d={`M${L.add.x - 4} ${L.add.y2 - 7} L${L.add.x} ${L.add.y2} L${L.add.x + 4} ${L.add.y2 - 7}z`} class="arrhead" />
              <text class="arrlabel" x={L.add.lx} y={L.add.ly}>
                AddTrack()
              </text>
            </g>

            {/* FairStack: the stack of tracks and the MCTrack array */}
            <rect class="bx bx-st" x={L.st.x} y={L.st.y} width={L.st.w} height={L.st.h} rx="3" />
            <text class="ttl" x={L.stT[0]} y={L.stT[1]}>
              FairStack
            </text>
