</Explainer>

<script>
  // Plays the beats of the current step: at beat i, it adds the class b<i> to the stage and writes the texts.
  type Beat = [number, Record<string, string>];
  const KEEP = ['nS', 'nP', 'ent'];
  for (const svg of document.querySelectorAll<SVGSVGElement>('svg.se[data-beats]')) {
    const beats: Beat[][] = JSON.parse(svg.dataset.beats!);
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const slots = new Map<string, SVGTextElement[]>();
    for (const el of svg.querySelectorAll<SVGTextElement>('[data-k]')) {
      const k = el.dataset.k!;
      if (!slots.has(k)) slots.set(k, []);
      slots.get(k)!.push(el);
    }
    let timers: number[] = [];
    let mine = '';
    const put = (vals: Record<string, string>) => {
      for (const [k, v] of Object.entries(vals)) {
        for (const el of slots.get(k) ?? []) {
          el.textContent = v;
          el.classList.toggle('note', v.startsWith('//'));
        }
      }
    };
    const beat = (n: number, i: number) => {
      put(beats[n][i][1]);
      if (i > 0) svg.classList.add('b' + i);
      mine = svg.getAttribute('class') ?? '';
    };
    const run = () => {
      timers.forEach((t) => clearTimeout(t));
      timers = [];
      const m = /\bnow(\d+)\b/.exec(svg.getAttribute('class') ?? '');
      const n = m ? Number(m[1]) - 1 : -1;
      if (!beats[n]) return;
      for (const [k, list] of slots) if (!KEEP.includes(k)) for (const el of list) el.textContent = '';
      beats[n].forEach(([t], i) => {
        if (reduce || t === 0) beat(n, i);
        else timers.push(window.setTimeout(() => beat(n, i), t));
      });
    };
    // The explainer sets the classes r1 … rn and now<n> for each step. A class change that is not ours starts
    // the beats of the new step.
    new MutationObserver(() => {
      if ((svg.getAttribute('class') ?? '') !== mine) run();
    }).observe(svg, { attributes: true, attributeFilter: ['class'] });
    run();
  }
</script>

