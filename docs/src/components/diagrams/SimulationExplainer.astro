    [0, { ...at0(0, 0), a0: 'GeneratePrimaries()', a1: '→ GenerateEvent()', a2: '  → MakeVertex()' }],
    [300, { a3: '  → ReadEvent()' }],
    [600, { a4: '    → AddTrack()', st: 'PushTrack()' }],
