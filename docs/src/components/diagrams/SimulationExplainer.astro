    [0, { ...at0(0, 3), a0: 'FinishEvent()' }],
    [300, { det: 'FinishEvent()' }],
    [900, { det: '', ent: 'cbmsim: 1 entry' }],
    [1700, { det: 'EndOfEvent()', nP: '0' }],
    [2400, { det: '', st: 'Reset()' }],
    [3000, {}],
  ],
];

