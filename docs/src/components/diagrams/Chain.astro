    fill: var(--fr-ink-3);
  }
  .ch-narrow .lane {
    font-size: 11.5px;
  }
  .run {
    font: 500 var(--fs) var(--fr-font-mono);
    letter-spacing: 0;
    fill: var(--fr-ink-2);
  }
  .nm {
    font: 600 var(--fs) var(--fr-font-mono);
    fill: var(--fr-ink);
  }
  .sub {
    font: 400 var(--fs-s) var(--fr-font-mono);
    fill: var(--fr-ink-3);
  }
  .sub.br,
  .sub.out {
    fill: var(--fr-ink-2);
