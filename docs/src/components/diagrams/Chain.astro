    .ch-wide {
      display: none;
    }
    .ch-narrow {
      display: block;
    }
  }
  /* The wide layout needs 480 px for its 11 px text. On a one-column page (phones and small tablets),
     a narrower container gets the narrow layout. The two-column hero (viewport wider than 60rem, see
     Hero.astro) keeps the wide layout, because the narrow one is too tall there. */
  @media (max-width: 60rem) {
    @container (max-width: 479.98px) {
      .ch-wide {
        display: none;
      }
      .ch-narrow {
        display: block;
      }
    }
  }

  .lane {
    font: 650 11px var(--fr-font-body);
