    font-size: 0.78rem;
    color: var(--fr-ink-3);
  }
  .ch-switch {
    display: inline-flex;
    border: 1px solid var(--fr-rule-strong);
    border-radius: 4px;
    overflow: hidden;
  }
  .ch-switch button {
    font: 600 0.78rem/1 var(--fr-font-mono);
    border: 0;
    background: var(--fr-paper);
    color: var(--fr-ink-2);
    padding: 0.5rem 0.9rem;
    cursor: pointer;
  }
  .ch-switch button + button {
    border-inline-start: 1px solid var(--fr-rule-strong);
  }
  .ch-switch button:hover {
    color: var(--fr-ink);
  }
  .ch-switch button[aria-pressed='true'] {
    background: var(--fr-ink);
    color: var(--fr-paper);
  }
  /* The ring stays inside the switch (overflow: hidden). A paper ring under it keeps it visible on the
     pressed button too. */
  .ch-switch button:focus-visible {
    outline-offset: -2px;
    box-shadow: inset 0 0 0 4px var(--fr-paper);
  }
  svg {
    width: 100%;
    height: auto;
    display: block;
    margin-top: 0.6rem;
  }
  .ch-wide {
    --fs: 11px;
    --fs-s: 11px;
