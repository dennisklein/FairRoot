    stroke: var(--fr-rule-strong);
    stroke-width: 1.4;
  }
  .ra {
    stroke-width: 1.1;
  }
  .ah {
    fill: var(--fr-rule-strong);
  }
  .bx {
    fill: var(--fr-paper);
    stroke: var(--fr-ink-2);
    stroke-width: 1.2;
    transition:
      fill 0.25s,
      stroke 0.25s;
  }
  .file .bx {
    fill: var(--fr-paper-2);
  }
  .fold {
    fill: none;
    stroke: var(--fr-ink-2);
    stroke-width: 1;
