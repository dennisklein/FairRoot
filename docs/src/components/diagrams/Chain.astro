    stroke-width: 1.8;
  }
  .g-tk path,
  .g-ft path {
    fill: none;
    stroke: var(--fr-bar);
    stroke-width: 1.8;
    stroke-dasharray: 2.6 1.6;
  }
  .g-ft path {
    stroke-width: 2.6;
    stroke-dasharray: none;
  }
  .g-mc {
    fill: none;
    stroke: var(--fr-ink-3);
