  }

  .ch-cap {
    margin: 0.5rem 0.15rem 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--fr-ink-2);
  }
  .ch-cap code {
    font-size: 0.92em;
    color: var(--fr-ink);
    background: var(--fr-paper-2);
    border: 1px solid var(--fr-rule);
    border-radius: 3px;
    padding: 0.02em 0.3em;
    white-space: nowrap;
  }
  @media (max-width: 30rem) {
    .fr-chain {
      padding: 0.6rem 0.5rem 0.5rem;
    }
  }
</style>
