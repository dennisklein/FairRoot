    key: ['bind', 'conn', 'root', 'boost'],
  },
};

const E = EXAMPLES[ex];
const KEY: Record<string, string> = {
  bind: 'binds',
  conn: 'connects',
  msg: 'message',
  chunk: 'chunk',
  evt: 'event',
  par: 'request, reply',
  ack: 'ack (empty message)',
  dash: 'only with',
  root: 'ROOT TMessage',
  boost: 'Boost archive',
};
const geo = (l: Layout) => JSON.stringify(Object.fromEntries(Object.entries(l.routes).map(([k, r]) => [k, r.pts])));
const d = (pts: P[]) => 'M' + pts.map((p) => p.join(' ')).join(' L');
---

<figure class="fr-mqt not-content" data-example={ex} data-still={JSON.stringify(E.still)}>
  <div class="mq-head">
    <div class="mq-ctl">
      <button type="button" data-act="pause">Pause</button>
      <button type="button" data-act="restart">Restart</button>
    </div>
    <span><code>{E.src}</code> · {E.info.map((s) => (typeof s === 'string' ? s : <code>{s.c}</code>))}</span>
  </div>
  {
    [E.wide, E.narrow].map((l) => (
      <svg class={`mq mq-${l.id}`} viewBox={`0 0 ${l.W} ${l.H}`} role="img" aria-label={E.aria} data-geo={geo(l)}>
        <g class="wires">
          {Object.values(l.routes)
            .filter((r) => r.c !== 'd')
            .map((r) => <path class={`w w-${r.c}${r.dash ? ' dash' : ''}`} d={d(r.pts)} />)}
          {Object.values(l.routes)
            .filter((r) => r.c === 'd')
            .map((r) => <path class="halo" d={d(r.pts)} />)}
          {Object.values(l.routes)
            .filter((r) => r.c === 'd')
            .map((r) => <path class="w w-d" d={d(r.pts)} />)}
        </g>
        {l.boxes.map((b) => {
          const t = E.txt[b.k];
          const top = b.h > 57 ? 18 : 17;
          return (
            <g class={`dev${t.srv ? ' srv' : ''}`} data-dev={b.k}>
              <rect class="bx" x={b.x} y={b.y} width={b.w} height={b.h} rx="3" />
              <text class="id" x={b.x + 10} y={b.y + top}>{t.id}</text>
              <text class="cls" x={b.x + 10} y={b.y + top + 15}>{t.cls}</text>
              <text class="does" x={b.x + 10} y={b.y + top + 30}>{t.does.map((s) => (typeof s === 'string' ? <tspan>{s}</tspan> : <tspan class="c">{s.c}</tspan>))}</text>
              {t.meter && [...Array(10).keys()].map((i) => <rect class="slot" data-slot={i} x={b.x + 10 + i * 12} y={b.y + b.h - 17} width="9" height="9" />)}
            </g>
          );
        })}
        <g class="ports">
          {l.ports.map(([x, y, c, bind]) => (
            <circle class={`pt pt-${c}${bind ? ' bind' : ''}`} cx={x} cy={y} r="3.5" />
          ))}
        </g>
        <g class="lbls">
          {l.lbls.map((b) => (
            <text class="lbl" x={b.x} y={b.y} text-anchor={b.a}>{b.t.map(([c, s]) => <tspan class={c}>{s}</tspan>)}</text>
          ))}
        </g>
        <g class="toks" />
      </svg>
    ))
  }
  <ul class="mq-key">
    {
      E.key.map((k) => (
        <li class={`k-${k}`}>
          <svg viewBox="0 0 16 12" aria-hidden="true">
            {k === 'bind' && <circle class="pt pt-d bind" cx="8" cy="6" r="3.5" />}
            {k === 'conn' && <circle class="pt pt-d" cx="8" cy="6" r="3.5" />}
            {(k === 'msg' || k === 'root') && <rect class="tk-root" x="3.5" y="1.5" width="9" height="9" />}
            {k === 'chunk' && <rect class="tk-root" x="5" y="3" width="6" height="6" />}
            {k === 'evt' && <rect class="tk-root" x="2.5" y="0.5" width="11" height="11" />}
            {k === 'boost' && <rect class="tk-boost" x="3.5" y="1.5" width="9" height="9" />}
            {k === 'par' && <rect class="tk-par" x="5" y="3" width="6" height="6" />}
            {k === 'ack' && <rect class="tk-ack" x="4.5" y="2.5" width="7" height="7" />}
            {k === 'dash' && <path class="w w-a dash" d="M0 6 H16" />}
          </svg>
          {KEY[k]}
          {k === 'dash' && (
            <>
              {' '}
              <code>--command static</code>
            </>
          )}
        </li>
      ))
    }
  </ul>
  <figcaption class="mq-cap">
    {
      ex === 'pixel' && (
        <>
          The sampler sends the events to the processors in turn. At its first message, a processor gets its parameter containers from the server, then it runs{' '}
          <code>PixelFindHits</code> on each message. With <code>--command static</code>, the sink sends an ack for each event, and the sampler ends only after the last ack.
        </>
      )
    }
    {
      ex === 'split' && (
        <>
          The generator sends each event as 10 chunks. A chunk message has all primaries and a header with the range of 10 primaries to simulate. The transporter
          simulates each chunk, and the merger sends the event when it has all 10 chunks. At the start, the transporter gets the run ID from the parameter server and
          sends its parameter containers there.
        </>
      )
    }
    {
      ex === 'serialization' && (
        <>
          Each message has two parts. On <code>data1</code>: an <code>ExHeader</code> as a Boost archive and the <code>MyDigi</code> array as a ROOT <code>TMessage</code>.
          On <code>data2</code>: the same header part and the <code>MyHit</code> objects as a Boost archive.
        </>
      )
    }
  </figcaption>
</figure>

<script>
  type P = [number, number];
  type Path = { pts: P[]; seg: number[]; len: number };
  type Still = { toks: [string, number, string][]; busy: string[]; meter?: number };
  type Tok = { r: string; t0: number; d: number; look: string; els: SVGGElement[]; park: number; done?: (t: Tok) => void };
  const NS = 'http://www.w3.org/2000/svg';
  const SPEED = 150; // units per second along a route
  const FAST = new Set(['ack', 'par']); // small messages move faster
  // Look of a message: size of one part, and the class of each part.
  const LOOK: Record<string, [number, string[]]> = {
    msg: [9, ['tk-root']],
    chunk: [6, ['tk-root']],
    evt: [11, ['tk-root']],
    par: [6, ['tk-par']],
    ack: [7, ['tk-ack']],
    ser1: [7, ['tk-boost', 'tk-root']],
    ser2: [7, ['tk-boost', 'tk-boost']],
  };
  const width = (look: string) => {
    const [s, parts] = LOOK[look];
    return parts.length * s + (parts.length - 1) * 2;
  };
  const measure = (pts: P[]): Path => {
    const seg = pts.slice(1).map((q, i) => Math.hypot(q[0] - pts[i][0], q[1] - pts[i][1]));
    return { pts, seg, len: seg.reduce((a, b) => a + b, 0) };
  };
  // The point at the distance s from the start of a path.
  const point = (p: Path, s: number): P => {
    let r = Math.max(0, Math.min(s, p.len));
    for (let i = 0; i < p.seg.length; i++) {
      if (r <= p.seg[i] || i === p.seg.length - 1) {
        const f = p.seg[i] ? Math.min(1, r / p.seg[i]) : 0;
        const [a, b] = [p.pts[i], p.pts[i + 1]];
        return [a[0] + (b[0] - a[0]) * f, a[1] + (b[1] - a[1]) * f];
      }
      r -= p.seg[i];
    }
    return p.pts[p.pts.length - 1];
  };

  for (const root of document.querySelectorAll<HTMLElement>('.fr-mqt')) {
    const ex = root.dataset.example!;
    const still = JSON.parse(root.dataset.still!) as Still;
    const svgs = [...root.querySelectorAll<SVGSVGElement>('svg.mq')];
    // For each layout: the paths by name, and the reversed paths as '~name'.
    const paths = svgs.map((s) => {
      const m: Record<string, Path> = {};
      for (const [k, pts] of Object.entries(JSON.parse(s.dataset.geo!) as Record<string, P[]>)) {
        m[k] = measure(pts);
        m['~' + k] = measure([...pts].reverse());
      }
      return m;
    });
    const layers = svgs.map((s) => s.querySelector<SVGGElement>('.toks')!);
    const btnPause = root.querySelector<HTMLButtonElement>('[data-act=pause]')!;
    const btnRestart = root.querySelector<HTMLButtonElement>('[data-act=restart]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let vis = 0; // index of the visible layout
    const pickVis = () => {
      const i = svgs.findIndex((s) => s.getBoundingClientRect().width > 0);
      vis = i < 0 ? 0 : i;
    };

    // ---- Simulation: tokens move along routes; events run at a time.
    let now = 0;
    let clock = 0; // the time of the arrival or event that runs now
    let toks: Tok[] = [];
    let evs: { t: number; f: () => void }[] = [];
    const later = (dt: number, f: () => void) => evs.push({ t: clock + dt, f });
    const send = (r: string, look: string, done?: (t: Tok) => void) => {
      const els = layers.map((layer) => {
        const g = document.createElementNS(NS, 'g');
        const [s, parts] = LOOK[look];
        const w = width(look);
        parts.forEach((c, i) => {
          const e = document.createElementNS(NS, 'rect');
          e.setAttribute('class', c);
          e.setAttribute('x', String(-w / 2 + i * (s + 2)));
          e.setAttribute('y', String(-s / 2));
          e.setAttribute('width', String(s));
          e.setAttribute('height', String(s));
          g.appendChild(e);
        });
        layer.appendChild(g);
        return g;
      });
      const t: Tok = { r, t0: clock, d: Math.max(0.3, paths[vis][r].len / (FAST.has(look) ? 1.7 * SPEED : SPEED)), look, els, park: -1, done };
      toks.push(t);
      return t;
    };
    const drop = (t: Tok) => {
      t.els.forEach((e) => e.remove());
      toks = toks.filter((x) => x !== t);
    };
    // Busy devices: a counter for each device, the class 'busy' while it is above 0.
    const busyN: Record<string, number> = {};
    const busy = (k: string, n: number) => {
      busyN[k] = Math.max(0, (busyN[k] || 0) + n);
      root.querySelectorAll(`[data-dev="${k}"]`).forEach((g) => g.classList.toggle('busy', busyN[k] > 0));
    };
    const flash = (k: string, dt = 0.3) => {
      busy(k, 1);
      later(dt, () => busy(k, -1));
    };
    // Queues: messages that wait at the input of a device.
    const Q: Record<string, Tok[]> = {};
    const park = (k: string, t: Tok) => {
      (Q[k] ||= []).push(t);
      t.park = Q[k].length - 1;
    };
    const take = (k: string) => {
      const t = (Q[k] ||= []).shift();
      if (t) drop(t);
      Q[k].forEach((x, i) => (x.park = i));
      return t;
    };
    const meter = (n: number) => root.querySelectorAll('[data-slot]').forEach((e) => e.classList.toggle('on', Number((e as SVGElement).dataset.slot) < n));

    // ---- The three topologies.
    const programs: Record<string, () => void> = {
      pixel: () => {
        const N = 3;
        const st = [...Array(N)].map(() => ({ busy: false, pars: false }));
        let rr = 0;
        // One request and one reply for each container: FairGeoParSet, PixelDigiParameters.
        const ask = (i: number, n: number, then: () => void) => {
          if (n === 0) return then();
          send(`~v-p${i}`, 'par', () => {
            flash('v', 0.25);
            later(0.12, () => send(`v-p${i}`, 'par', () => ask(i, n - 1, then)));
          });
        };
        const run = (i: number) => {
          const p = st[i];
          if (p.busy || !(Q['p' + i] || []).length) return;
          take('p' + i);
          p.busy = true;
          busy('p' + i, 1);
          const work = () =>
            later(0.55, () => {
              p.busy = false;
              busy('p' + i, -1);
              send(`p${i}-k`, 'msg', () => {
                flash('k');
                send('k-s', 'ack');
              });
              run(i);
            });
          if (p.pars) work();
          else
            ask(i, 2, () => {
              p.pars = true;
              work();
            });
        };
        const sample = () => {
          const i = rr;
          rr = (rr + 1) % N;
          send(`s-p${i}`, 'msg', (t) => {
            park('p' + i, t);
            run(i);
          });
          later(0.6, sample);
        };
        later(0.2, sample);
      },
      split: () => {
        const NCH = 10;
        const T = { busy: true, ready: false };
        let got = 0;
        // PreRun(): "ReportSimDevice" and its reply, then the parameter containers.
        const report = (n: number) => {
          if (n === 0) {
            T.ready = true;
            T.busy = false;
            busy('t', -1);
            return run();
          }
          send('~v-t', 'par', () => {
            flash('v', 0.25);
            later(0.12, () => send('v-t', 'par', () => report(n - 1)));
          });
        };
        const run = () => {
          if (T.busy || !T.ready || !(Q.t || []).length) return;
          take('t');
          T.busy = true;
          busy('t', 1);
          later(0.22, () => {
            T.busy = false;
            later(0.12, () => busy('t', -1)); // no flicker between two chunks
            // The meter keeps all 10 slots on until the first chunk of the next event.
            send('t-m', 'chunk', () => {
              got = (got % NCH) + 1;
              meter(got);
              if (got < NCH) return;
              flash('m', 0.3);
              later(0.15, () =>
                send('m-k', 'evt', () => {
                  flash('k');
                  send('k-g', 'ack');
                })
              );
            });
            run();
          });
        };
        const gen = () => {
          send('g-t', 'chunk', (t) => {
            park('t', t);
            run();
          });
          later(0.34, gen);
        };
        busy('t', 1);
        later(0.15, () => report(2));
        later(0.3, gen);
      },
      serialization: () => {
        const st = [{ busy: false }, { busy: false }];
        let rr = 0;
        const run = (i: number) => {
          const p = st[i];
          if (p.busy || !(Q['p' + i] || []).length) return;
          take('p' + i);
          p.busy = true;
          busy('p' + i, 1);
          later(0.6, () => {
            p.busy = false;
            busy('p' + i, -1);
            send(`p${i}-k`, 'ser2', () => flash('k'));
            run(i);
          });
        };
        const sample = () => {
          const i = rr;
          rr = (rr + 1) % 2;
          send(`s-p${i}`, 'ser1', (t) => {
            park('p' + i, t);
            run(i);
          });
          later(0.7, sample);
        };
        later(0.2, sample);
      },
    };

    const clear = () => {
      toks.forEach((t) => t.els.forEach((e) => e.remove()));
      toks = [];
      evs = [];
      for (const k in Q) delete Q[k];
      for (const k in busyN) busy(k, -busyN[k]);
      meter(0);
      now = clock = 0;
    };
    const render = () => {
      for (const t of toks) {
        const w = width(t.look);
        t.els.forEach((g, j) => {
          const p = paths[j][t.r];
          // A long queue stops before the start of the route, so it does not cover the port of the sender.
          const s = t.park >= 0 ? Math.max(w / 2 + 6, p.len - w / 2 - 6 - t.park * (w * 0.6 + 2)) : (Math.min(1, (now - t.t0) / t.d) || 0) * p.len;
          const [x, y] = point(p, s);
          g.setAttribute('transform', `translate(${x.toFixed(1)} ${y.toFixed(1)})`);
        });
      }
    };
    // Run all arrivals and events up to the time `to`, in time order.
    const advance = (to: number) => {
      for (;;) {
        let tok: Tok | null = null;
        let ta = Infinity;
        for (const t of toks)
          if (t.park < 0 && t.t0 + t.d < ta) {
            ta = t.t0 + t.d;
            tok = t;
          }
        let ei = -1;
        let te = Infinity;
        evs.forEach((e, i) => {
          if (e.t < te) {
            te = e.t;
            ei = i;
          }
        });
        if (Math.min(ta, te) > to) break;
        if (tok && ta <= te) {
          // Arrived: the callback can park the message in a queue; else it goes away.
          clock = ta;
          tok.park = -2;
          const f = tok.done;
          tok.done = undefined;
          if (f) f(tok);
          if (tok.park === -2) drop(tok);
        } else {
          clock = te;
          evs.splice(ei, 1)[0].f();
        }
      }
      now = clock = to;
    };
    // The static picture: some messages on their way.
    const showStill = () => {
      clear();
      pickVis();
      for (const [r, u, look] of still.toks) {
        const t = send(r, look);
        t.t0 = -u * t.d;
      }
      still.busy.forEach((k) => busy(k, 1));
      if (still.meter) meter(still.meter);
      render();
    };

    let playing = !reduce;
    let visible = !('IntersectionObserver' in window);
    let running = false;
    let fresh = true; // the static picture shows; the next start begins at time 0
    let raf = 0;
    let last = 0;
    const frame = (ts: number) => {
      if (!running) return;
      const dt = Math.min(0.05, (ts - (last || ts)) / 1000);
      last = ts;
      advance(now + dt);
      render();
      raf = requestAnimationFrame(frame);
    };
    const start = () => {
      if (running || !playing || !visible) return;
      if (fresh) {
        clear();
        pickVis();
        programs[ex]();
        fresh = false;
      }
      running = true;
      last = 0;
      raf = requestAnimationFrame(frame);
    };
    const stop = () => {
      running = false;
      cancelAnimationFrame(raf);
    };
    const label = () => {
      btnPause.textContent = playing ? 'Pause' : 'Play';
    };
    btnPause.addEventListener('click', () => {
      playing = !playing;
      if (playing) start();
      else stop();
      label();
    });
    btnRestart.addEventListener('click', () => {
      stop();
      playing = true;
      fresh = true;
      start();
      label();
    });
    showStill();
    label();
    if ('ResizeObserver' in window) new ResizeObserver(pickVis).observe(root);
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (es) => {
          for (const e of es) {
            visible = e.isIntersecting;
            if (visible && playing && !running) {
              fresh = true;
              start();
            } else if (!visible && running) stop();
          }
        },
        { threshold: 0.2 }
      ).observe(root);
    } else start();
  }
</script>

<style>
  .fr-mqt {
    container-type: inline-size;
    min-width: 0;
    margin: 1.5rem 0;
    border: 1px solid var(--fr-rule);
    background: var(--fr-paper);
    border-radius: 6px;
    padding: 0.75rem 0.75rem 0.6rem;
  }
  .mq-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.4rem 0.75rem;
    flex-wrap: wrap;
    font-size: 0.78rem;
    color: var(--fr-ink-3);
    text-wrap: pretty; /* no code name alone on the last line on phones */
  }
  .mq-ctl {
    display: inline-flex;
    border: 1px solid var(--fr-rule-strong);
    border-radius: 4px;
    overflow: hidden;
  }
  .mq-ctl button {
    font: 600 0.78rem/1 var(--fr-font-body);
    border: 0;
    background: var(--fr-paper);
    color: var(--fr-ink-2);
    padding: 0.5rem 0.85rem;
    min-width: 4.6rem;
    cursor: pointer;
  }
  .mq-ctl button + button {
    border-inline-start: 1px solid var(--fr-rule-strong);
  }
  .mq-ctl button:hover {
    background: var(--fr-paper-2);
    color: var(--fr-ink);
  }
  .mq-ctl button:focus-visible {
    outline: 2px solid var(--fr-link);
    outline-offset: -2px;
  }
  .fr-mqt code {
    font-family: var(--fr-font-mono);
    font-size: 0.92em;
    color: var(--fr-ink);
    background: var(--fr-paper-2);
    border: 1px solid var(--fr-rule);
    border-radius: 3px;
    padding: 0.02em 0.3em;
    overflow-wrap: anywhere;
  }
  svg.mq {
    width: 100%;
    height: auto;
    display: block;
    margin-top: 0.6rem;
  }
  svg.mq-narrow {
    display: none;
    max-width: 420px;
    margin-inline: auto;
  }
  @container (max-width: 599.98px) {
    svg.mq-wide {
      display: none;
    }
    svg.mq-narrow {
      display: block;
    }
  }

  /* Wires and ports */
  .w {
    fill: none;
    stroke-width: 1.3;
    stroke-linejoin: round;
  }
  .w-d {
    stroke: var(--fr-ink-3);
  }
  .w-p {
    stroke: var(--fr-sky);
  }
  .w-a {
    stroke: var(--fr-teal);
  }
  .w-a.dash {
    stroke-dasharray: 5 4;
  }
  .halo {
    fill: none;
    stroke: var(--fr-paper);
    stroke-width: 7;
  }
  .pt {
    fill: var(--fr-paper);
    stroke-width: 1.4;
  }
  .pt-d {
    stroke: var(--fr-ink-2);
  }
  .pt-p {
    stroke: var(--fr-sky);
  }
  .pt-a {
    stroke: var(--fr-teal);
  }
  .pt-d.bind {
    fill: var(--fr-ink-2);
  }
  .pt-p.bind {
    fill: var(--fr-sky);
  }
  .pt-a.bind {
    fill: var(--fr-teal);
  }

  /* Devices */
  .dev .bx {
    fill: var(--fr-paper);
    stroke: var(--fr-ink-2);
    stroke-width: 1.2;
    transition:
      fill 0.2s,
      stroke 0.2s;
  }
  .dev:global(.busy) .bx {
    fill: var(--fr-saffron-tint);
    stroke: var(--fr-bar);
  }
  .dev.srv:global(.busy) .bx {
    fill: var(--fr-sky-tint);
    stroke: var(--fr-sky);
