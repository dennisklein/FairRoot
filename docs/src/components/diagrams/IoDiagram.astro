      { n: 'GeoTracks', x: 12, y: 102 },
      { n: 'MCTrack', x: 12, y: 124 },
      { n: 'FairTestDetectorPoint', x: 12, y: 146, port: true },
      { n: 'MCEventHeader.', x: 12, y: 168 },
    ],
  },
  snk: {
