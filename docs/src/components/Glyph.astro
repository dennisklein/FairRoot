---
// The FairRoot mark: a track bends in the magnetic field and crosses three detector planes.
// Each crossing makes a hit.
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
const hits = [
  [9, 13.79],
  [16, 11.78],
  [23, 8.23],
];
---

<svg class="fr-glyph" width={size} height={Math.round((size * 18) / 30)} viewBox="0 0 30 18" aria-hidden="true">
  {hits.map(([x]) => <line x1={x} y1="1.5" x2={x} y2="16.5" stroke="currentColor" stroke-width="1.6" />)}
  <path d="M1.5 14.5 A40 40 0 0 0 28.5 4" fill="none" stroke="currentColor" stroke-width="1.1"></path>
  <circle cx="1.5" cy="14.5" r="1.3" fill="currentColor"></circle>
  {hits.map(([x, y]) => <rect x={x - 1.9} y={y - 1.9} width="3.8" height="3.8" fill="var(--fr-saffron)" stroke="var(--fr-bar)" stroke-width="0.6" />)}
</svg>

<style>
  .fr-glyph {
    flex: none;
    color: var(--fr-ink);
  }
</style>
