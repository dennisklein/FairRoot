---
// The hero of the home page: the claim, two actions, the clone command and the chain of a simulation
// and a reconstruction.
import Chain from '../diagrams/Chain.astro';
import CopyButton from '../CopyButton.astro';
import { build } from 'virtual:fairroot/data';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (link: string) => (link.startsWith('/') && !link.startsWith(base + '/') ? base + link : link);
const install = `git clone -b dev ${build.repo}`;
// Two lines, so that the command fits the column; the copy button copies one line.
const shown = `git clone -b dev \\\n    ${build.repo}`;
---

<div class="fr-hero">
  <div class="h-text">
    <p class="fr-eyebrow">C++ framework on ROOT and VMC · LGPL-3.0</p>
    <h1 id="_top" data-page-title>{title}</h1>
    {tagline && <p class="h-lead" set:html={tagline} />}
    <div class="h-cta">
      {
        actions.map((a) => (
          <a class:list={['h-btn', { pri: a.variant === 'primary' }]} href={href(a.link)}>
            {a.text}
          </a>
        ))
      }
    </div>
    <div class="h-install">
      <span aria-hidden="true">$</span>
      <code>{shown}</code>
      <CopyButton text={install} label="Copy the clone command" />
    </div>
  </div>
  <Chain />
</div>

<style>
  .fr-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 2.25rem;
    align-items: center;
    padding-block: 1.5rem 2.5rem;
  }
  @media (max-width: 60rem) {
    .fr-hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
      padding-block: 0.5rem 1.75rem;
    }
  }
  h1 {
    font-size: clamp(2.1rem, 1.4rem + 2.4vw, 3.05rem);
    line-height: 1.03;
    font-weight: 800;
    font-stretch: 118%;
    letter-spacing: -0.026em;
    margin: 0.6rem 0 1rem;
    text-wrap: balance;
    color: var(--fr-ink);
  }
  .h-lead {
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--fr-ink-2);
    margin: 0 0 1.5rem;
    max-width: 46ch;
  }
  .h-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .h-btn {
    display: inline-flex;
    align-items: center;
    font: 600 0.9375rem/1 var(--fr-font-body);
    padding: 0.75rem 1.1rem;
    border-radius: 4px;
    border: 1px solid var(--fr-rule-strong);
    color: var(--fr-ink);
    text-decoration: none;
    background: var(--fr-paper);
  }
  .h-btn:hover {
    border-color: var(--fr-ink-3);
    color: var(--fr-ink);
  }
  .h-btn.pri {
    background: var(--fr-ink);
    border-color: var(--fr-ink);
    color: var(--fr-paper);
  }
  .h-btn.pri:hover {
    background: var(--fr-ink-2);
    color: var(--fr-paper);
  }
  .h-install {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin-top: 1.25rem;
    border: 1px solid var(--fr-rule);
    background: var(--fr-paper-2);
    border-radius: 4px;
    padding: 0.4rem 0.45rem 0.4rem 0.75rem;
    max-width: 31rem;
    font-size: 0.875rem;
  }
  .h-install span {
    color: var(--fr-ink-3);
    font-family: var(--fr-font-mono);
  }
  .h-install code {
    font-family: var(--fr-font-mono);
    color: var(--fr-ink);
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    white-space: pre;
    line-height: 1.6;
    scrollbar-width: none;
    background: none;
    border: 0;
    padding: 0;
  }
</style>
