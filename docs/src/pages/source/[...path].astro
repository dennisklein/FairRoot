---
// Source browser: one page for each C++ file in fairroot/, examples/ and templates/.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import { paths } from 'virtual:fairroot/data';
import { model, base, codeTheme, sourceSidebar, githubUrl, guidesForFile } from '../../lib/model.mjs';
import { renderSourceFile } from '../../../scripts/source.mjs';
import { issues, issueUrl } from '../../lib/issues.mjs';
import '../../styles/source.css';
import '../../styles/issues.css';

export function getStaticPaths() {
  return model().sourceFiles.map((f: string) => ({ params: { path: f } }));
}

const file = Astro.params.path as string;
const m = model();
const out = await renderSourceFile(m, file, { theme: codeTheme(), repoRoot: paths.repoRoot });
const fileRec = m.files.get(file);
const defined = (fileRec?.defines ?? []).filter((c: any) => c.public);
const isPublic = m.publicHeaders.has(file);
const docs = await getCollection('docs');
const guides = guidesForFile(docs, file);
const name = file.split('/').pop()!;
const lib = m.libraryOf(file);
const kindOf = () => {
  if (file.endsWith('.h')) return isPublic ? 'public header' : 'header';
  if (file.endsWith('.C')) return 'ROOT macro';
  return 'source';
};
// Open issues of the code issue register: a list above the code, a mark on their lines,
// and a link at the end of the first line of each issue.
const RANK: Record<string, number> = { high: 3, medium: 2, low: 1 };
const fileIssues = issues.filter((i: any) => i.file === file && i.status === 'open');
let codeHtml = out.html;
if (fileIssues.length) {
  const rows = out.html.split(/(?=<span class="row" id="L\d+">)/);
  const sev = new Map<number, string>();
  const flags = new Map<number, any[]>();
  for (const i of fileIssues) {
    if (!i.line) continue;
    for (let n = i.line; n <= (i.lineEnd ?? i.line); n++) if (!sev.has(n) || RANK[i.severity] > RANK[sev.get(n)!]) sev.set(n, i.severity);
    flags.set(i.line, [...(flags.get(i.line) ?? []), i]);
  }
  codeHtml = rows
    .map((r: string, k: number) => {
      const n = k + 1;
      if (!sev.has(n)) return r;
      r = r.replace('<span class="row"', `<span class="row iss ${sev.get(n)}"`);
      const f = flags.get(n);
      if (!f) return r;
      const links = f.map((i) => `<a class="src-iss-flag ${i.severity}" href="${issueUrl(i.id)}" title="${i.title.replace(/"/g, '&quot;')}">${i.id}</a>`).join('');
      return r.slice(0, -'</span>'.length) + links + '</span>';
    })
    .join('');
}
const issueCount = (s: string) => fileIssues.filter((i: any) => i.severity === s).length;
const area: Record<string, string> = { fairroot: 'FairRoot', examples: 'the FairRoot examples', templates: 'the FairRoot templates' };
---

<StarlightPage
  frontmatter={{
    title: name,
    description: `Source of ${file} in ${area[file.split('/')[0]] ?? 'FairRoot'}.`,
    eyebrow: `Source · ${file.split('/').slice(0, -1).join('/')}/`,
    titleKind: kindOf(),
    searchTitle: file,
    tableOfContents: false,
    guides,
  }}
  sidebar={sourceSidebar(file)}
  headings={[]}
>
  {
    defined.length > 0 && (
      <p class="src-defines">
        Defines {defined.map((c: any) => `${c.kind} ${c.name}`).join(', ')}.
      </p>
    )
  }
  {
    guides.length > 0 && (
      <p class="src-guides">
        Described in{' '}
        {guides.map((g: any, i: number) => (
          <>
            {i > 0 && ', '}
            <a href={`${base}${g.link}`}>{g.label}</a>
          </>
        ))}
        .
      </p>
    )
  }
  {
    fileIssues.length > 0 && (
      <details class="src-issues not-content" open={fileIssues.length <= 3}>
        <summary>
          {fileIssues.length} known {fileIssues.length === 1 ? 'issue' : 'issues'} in this file
          <span class="src-issues-sev">
            {['high', 'medium', 'low'].filter((s) => issueCount(s)).map((s) => <span class={`iss-sev ${s}`}>{issueCount(s)} {s}</span>)}
          </span>
        </summary>
        <ul>
          {fileIssues.map((i: any) => (
            <li>
              <a class="src-iss-id" href={issueUrl(i.id)}>{i.id}</a>
              <span class={`iss-sev ${i.severity}`}>{i.severity}</span>
              <span class="src-iss-title">{i.title}</span>
              {i.line && <a class="src-iss-line" href={`#L${i.line}${i.lineEnd ? `-L${i.lineEnd}` : ''}`}>line {i.line}</a>}
            </li>
          ))}
        </ul>
      </details>
    )
  }
  <div class="src-head not-content">
    <span class="src-path">{file}</span>
    <span class="src-info">{out.lines} lines · C++{lib && <> · <code>FairRoot::{lib.library}</code></>}</span>
    <span class="src-acts">
      {
        defined.map((c: any) => (
          <a class="fr-badge mark" href={c.url}>
            API: {c.short}
          </a>
        ))
      }
      <a class="fr-badge" href={githubUrl(file)}>GitHub ↗</a>
    </span>
  </div>
  <div class="src-code not-content" data-pagefind-ignore>
    <pre><code set:html={codeHtml} /></pre>
    <div class="src-card" role="tooltip" hidden></div>
  </div>
  <script type="application/json" id="src-symbols" set:html={JSON.stringify(out.symbols).replace(/</g, '\\u003c')} />
</StarlightPage>

<script>
  // Line marks from the URL (#L10 or #L10-L20), shift-click to mark a range,
  // and a card with the symbol on hover or focus.
  const code = document.querySelector<HTMLElement>('.src-code');
  if (code) {
    const rows = () => code.querySelectorAll<HTMLElement>('.row.hl');
    const mark = () => {
      rows().forEach((r) => r.classList.remove('hl'));
      const m = /^#L(\d+)(?:-L(\d+))?$/.exec(location.hash);
      if (!m) return;
      const a = Number(m[1]);
      const b = Number(m[2] ?? m[1]);
      for (let i = Math.min(a, b); i <= Math.max(a, b); i++) document.getElementById(`L${i}`)?.classList.add('hl');
    };
    mark();
    addEventListener('hashchange', mark);
    code.addEventListener('click', (e) => {
      const ln = (e.target as HTMLElement).closest<HTMLAnchorElement>('a.ln');
      if (!ln || !e.shiftKey) return;
      const cur = /^#L(\d+)/.exec(location.hash);
      if (!cur) return;
      e.preventDefault();
      const to = ln.getAttribute('href')!.slice(2);
      history.replaceState(null, '', `#L${cur[1]}-L${to}`);
      mark();
    });

    const symbols = JSON.parse(document.getElementById('src-symbols')?.textContent ?? '[]');
    const card = code.querySelector<HTMLElement>('.src-card')!;
    let timer: number | undefined;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const show = (a: HTMLElement) => {
      const s = symbols[Number(a.dataset.s)];
      if (!s) return;
      clearTimeout(timer);
      card.innerHTML = `<span class="k">${esc(s.k)}</span><b>${esc(s.n)}</b>${s.s && s.s !== s.n ? `<code>${esc(s.s)}</code>` : ''}<span class="l">${esc(s.l)}</span>`;
      card.hidden = false;
      const box = code.getBoundingClientRect();
      const r = a.getBoundingClientRect();
      const left = Math.max(8, Math.min(r.left - box.left, box.width - card.offsetWidth - 8));
      card.style.left = `${left}px`;
      card.style.top = `${r.bottom - box.top + code.scrollTop + 6}px`;
    };
    const hide = () => {
      timer = window.setTimeout(() => (card.hidden = true), 120);
    };
    code.addEventListener('pointerover', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLElement>('a.sym');
      if (a) show(a);
    });
    code.addEventListener('pointerout', (e) => {
      if ((e.target as HTMLElement).closest('a.sym')) hide();
    });
    code.addEventListener('focusin', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLElement>('a.sym');
      if (a) show(a);
    });
    code.addEventListener('focusout', hide);
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape') card.hidden = true;
    });
  }
</script>
